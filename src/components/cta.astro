---
import Link from "./ui/link.astro";

const { background_color, title, text_color } = Astro.props;
---

<div
  style={`background-color: ${background_color}; color: ${text_color};`}
  class="p-8 md:px-20 md:py-20 mt-20 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center">
  <h2 class="text-4xl md:text-6xl tracking-tight">
    {title}
  </h2>
  <p class="mt-4 text-lg md:text-xl">
    Pull content from anywhere and serve it fast with Astro's next-gen island
    architecture.
  </p>
  <div class="flex mt-5">
    <Link href="#" style="inverted">Get Started</Link>
  </div>
</div>
